class ActivePanel():
    def __init__(self, **kwargs):

        self.options = {}
        self.setting_attribute = ''
        self.categories = []
        self.location = 0
        self.length = 0
        self.widgets = []

        self.__dict__.update(kwargs)

        if self.categories:
            self.length = sum([len(d) for d in self.options.items()])
        else:
            self.length = len(self.options)

    def callback(self):
        global game_state
        game_state.active_panel_name = self.name
        game_state.focused_idx = self.location
        game_state.set_focusables()


active_panel_dict = {}
active_panel_dict['presets'] = ActivePanel(options=presets,
                                    setting_attribute = 'presets',
                                    location = 0,
                                    name = 'presets')
