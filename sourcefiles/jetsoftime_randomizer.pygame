# TODO:  Autodetect location of rom
snes_rom_path = '/home/nausea911/Downloads/romhacks/jetsoftime' # TODO:  Add in manually
# snes_rom_path = '/userdata/roms/snes' # TODO:  Add in manually
rom_file='ct.sfc' # TODO  Add in manually
output_path = os.path.join(snes_rom_path,'jetsoftime_rom')

if not os.path.isdir(output_path):
    os.makedirs(output_path)

pygame.init()

# —————— Setup display ——————
# Fullscreen mode
screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
screen_width, screen_height = screen.get_size()
pygame.display.set_caption("Pygame GUI Demo")
font = pygame.font.SysFont(None, 24)

# —————— Layout positions ——————
# Divider at one-third, panel content offset
DIVIDER_X = screen_width // 3
PANEL_X = DIVIDER_X + 20

# —————— Colors ——————
WHITE = (255, 255, 255)
GRAY = (200, 200, 200)
DARK = (50, 50, 50)
BLUE = (0, 120, 215)
RED = (200, 0, 0)

# —————— GUI state ——————
# active_panel: 1=Presets, 2=Mode, 3=Difficulty, 4=Flags
active_panel = 1

# Lock state while generating
generating_rom = False
complete_time = None
complete_text = ''

settings = Settings()

# Current choices
preset_choice = "Default"

# —————— Preset configurations ——————
presets = {'Default':Settings(),
           'New Player':Settings.get_new_player_presets(),
           'Race':Settings.get_race_presets(),
           'Tourney T8':Settings.get_tourney_top8_preset(),
           'Lost Worlds':Settings.get_lost_worlds_presets(),
           'Hard':Settings.get_hard_presets()}
flags =  {name:False for name in GameFlags._member_names_}

# —————— Navigation state ——————
focusables = []  # dynamically rebuilt
focused_idx = 0  # index in focusables

# —————— Helpers ——————
def draw_text(text, pos, color=DARK):
    img = font.render(text, True, color)
    screen.blit(img, pos)

# —————— Widget base ——————
class Widget:
    def draw(self, is_focused=False):
        pass

    def handle_event(self, evt):
        pass

    def activate(self):
        pass

# —————— Button ——————
class Button(Widget):
    def __init__(self, rect, text, callback):
        self.rect = pygame.Rect(rect)
        self.text = text
        self.callback = callback

    def draw(self, is_focused=False):
        color = BLUE if self.rect.collidepoint(pygame.mouse.get_pos()) else GRAY
        pygame.draw.rect(screen, color, self.rect)
        draw_text(self.text, (self.rect.x + 10, self.rect.y + 8))
        if is_focused:
            pygame.draw.rect(screen, RED, self.rect, 2)

    def handle_event(self, evt):
        if evt.type == pygame.MOUSEBUTTONDOWN and evt.button == 1:
            if self.rect.collidepoint(evt.pos):
                self.activate()

    def activate(self):
        self.callback()

# —————— RadioButton ——————
class RadioButton(Widget):
    def __init__(self, pos, label, group):
        self.pos = pos
        self.label = label
        self.group = group
        self.radius = 8

    def draw(self, is_focused=False):
        global preset_choice, settings
        pygame.draw.circle(screen, DARK, self.pos, self.radius, 1)

        if self.group == "presets":
            sel = preset_choice
        elif self.group == "mode":
            sel = settings.game_mode.name
        elif self.group == "item":
            sel = settings.item_difficulty.name
        elif self.group == 'enemy':
            sel = settings.enemy_difficulty.name
        else:
            return

        sel_label = ' '.join(sel.lower().split('_'))
        if sel_label == self.label.lower():
            pygame.draw.circle(screen, DARK, self.pos, self.radius - 3)

        draw_text(self.label.capitalize(), (self.pos[0] + 15, self.pos[1] - 8))

        if is_focused:
            pygame.draw.circle(screen, RED, self.pos, self.radius + 4, 2)

    def handle_event(self, evt):
        if evt.type == pygame.MOUSEBUTTONDOWN and evt.button == 1:
            dx = evt.pos[0] - self.pos[0]
            dy = evt.pos[1] - self.pos[1]
            if dx * dx + dy * dy <= self.radius * self.radius:
                self.activate()

    def activate(self):
        global preset_choice, settings, flags

        if self.group == "presets":
            preset_choice = self.label
            settings = presets[preset_choice]
        elif self.group == "mode":
            settings.game_mode = GameMode.inv_str_dict()[self.label]
            print(settings.game_mode.value)
            print(self.label)
        elif self.group == "item":
            settings.item_difficulty = Difficulty.inv_str_dict()[self.label]
        elif self.group == "enemy":
            settings.enemy_difficulty = Difficulty.inv_str_dict()[self.label]
        else:
            return

# —————— CheckBox ——————
class CheckBox(Widget):
    def __init__(self, pos, label):
        self.rect = pygame.Rect(pos[0], pos[1], 16, 16)
        self.label = label

    def draw(self, is_focused=False):
        global flags
        pygame.draw.rect(screen, DARK, self.rect, 1)

        # Set flags
        flags = {name:False for name in GameFlags._member_names_}
        current_flags = [s.split('.')[-1] for s in settings.gameflags.to_jot_json()]
        for current_flag in current_flags:
            flags[current_flag] = True

        if flags[self.label]:
            pygame.draw.line(screen, DARK, self.rect.topleft, self.rect.bottomright, 2)
            pygame.draw.line(screen, DARK, self.rect.topright, self.rect.bottomleft, 2)

        draw_text(self.label, (self.rect.x + 25, self.rect.y - 2))

        if is_focused:
            pygame.draw.rect(screen, RED, self.rect.inflate(6, 6), 2)

    def handle_event(self, evt):
        if evt.type == pygame.MOUSEBUTTONDOWN and evt.button == 1:
            label_rect = font.render(self.label, True, DARK).get_rect(
                topleft=(self.rect.x + 25, self.rect.y - 2)
            )

            if self.rect.collidepoint(evt.pos) or label_rect.collidepoint(evt.pos):
                self.activate()

    def activate(self):
        global flags

        flags[self.label] = not flags[self.label]
        flags_value = sum([GameFlags._member_map_[name].value for name, is_set in flags.items() if is_set])
        settings.gameflags = GameFlags(flags_value)
        settings.fix_flag_conflicts()

# —————— Callbacks ——————

def on_presets():
    global active_panel, focused_idx
    active_panel = 1
    focused_idx = 0
    rebuild_focusables()

def on_mode():
    global active_panel, focused_idx
    active_panel = 2
    focused_idx = 1
    rebuild_focusables()


def on_difficulty():
    global active_panel, focused_idx
    active_panel = 3
    focused_idx = 2
    rebuild_focusables()


def on_flags():
    global active_panel, focused_idx
    active_panel = 4
    focused_idx = 3
    rebuild_focusables()


def on_generate():
    global generating_rom,complete_time,complete_text
    generating_rom=True

    rebuild_focusables()

    names = read_names()
    settings.seed = "".join(random.choice(names) for i in range(2))

    rom = Path(os.path.join(snes_rom_path, rom_file)).read_bytes()
    
    rando = Randomizer(rom, is_vanilla=False, settings=settings, config=None)
    rando.set_random_config()

    base_name, _ = os.path.splitext(rom_file)
    writer = RandomizerWriter(rando, base_name=base_name)
    writer.write_output_rom(Path(output_path))
    
    generating_rom=False
    complete_text = f"ROM Complete: {writer.out_string}.sfc"
    complete_time = pygame.time.get_ticks()
    rebuild_focusables()

# —————— Instantiate widgets ——————
button_start = 50
button_step = 30
buttons = [
    Button((20, 20, 100, 30), "Presets", on_presets),
    Button((20, 60, 100, 30), "Mode", on_mode),
    Button((20, 100, 100, 30), "Difficulty", on_difficulty),
    Button((20, 140, 100, 30), "Flags", on_flags),
    Button((20, screen_height - 60, 100, 30), "Generate", on_generate)
]


preset_buttons = [(button_start + button_step*i, mode) for i, mode in  enumerate(presets.keys())]
preset_radios = [ RadioButton((PANEL_X, y), lbl, "presets")  for y, lbl in preset_buttons]

mode_buttons = [(button_start + button_step*i, s) for i, s in  enumerate(GameMode.str_dict().values())]
mode_radios = [ RadioButton((PANEL_X, y), lbl, "mode") for y, lbl in mode_buttons]

item_buttons = [(button_start + button_step*i, s) for i, s in  enumerate(Difficulty.str_dict().values())]
item_radios = [ RadioButton((PANEL_X, y), lbl, "item")  for y, lbl in item_buttons]

enemy_buttons = [(200 + button_step*i, s) for i, s in  enumerate(Difficulty.str_dict().values())]
enemy_radios = [ RadioButton((PANEL_X, y), lbl, "enemy")  for y, lbl in enemy_buttons]

flag_buttons = [(button_start + button_step*i, s) for i, s in  enumerate(flags.keys())]
flag_checks = [ CheckBox((PANEL_X, y), lbl) for y, lbl in flag_buttons]

# —————— Build focusables ——————
# TODO: Generalize
def rebuild_focusables():
    global focusables
    focusables = buttons.copy()
    if active_panel == 1:
        focusables += preset_radios
    elif active_panel == 2:
        focusables += mode_radios
    elif active_panel == 3:
        focusables += item_radios + enemy_radios
    elif active_panel == 4:
        focusables += flag_checks
    else:
        return

rebuild_focusables()

# —————— Input init ——————
pygame.joystick.init()
for i in range(pygame.joystick.get_count()):
    pygame.joystick.Joystick(i).init()

# —————— Main loop ——————
clock = pygame.time.Clock()
while True:
    now = pygame.time.get_ticks()

    for evt in pygame.event.get():
        if evt.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        screen.fill(WHITE)
        if generating_rom:
            continue
        elif complete_time and now - complete_time <= 2000:
            draw_text(complete_text, (PANEL_X, screen_height - 40), BLUE)
            continue

        if evt.type == pygame.KEYDOWN:
            if evt.key == pygame.K_TAB:
                focused_idx = (focused_idx + (-1 if evt.mod & pygame.KMOD_SHIFT else 1)) % len(focusables)
            elif evt.key in (pygame.K_UP, pygame.K_LEFT):
                focused_idx = (focused_idx - 1) % len(focusables)
            elif evt.key in (pygame.K_DOWN, pygame.K_RIGHT):
                focused_idx = (focused_idx + 1) % len(focusables)
            elif evt.key in (pygame.K_RETURN, pygame.K_SPACE):
                focusables[focused_idx].activate()
        elif evt.type == pygame.JOYBUTTONDOWN and evt.button == 0:
            focusables[focused_idx].activate()

        if active_panel == 1:
            active_options = preset_radios
        elif active_panel == 2:
            active_options = mode_radios
        elif active_panel == 3:
            active_options = item_radios + enemy_radios
        elif active_panel == 4:
            active_options = flag_checks
        else:
            continue

        for w in buttons + active_options:
            w.handle_event(evt)

    pygame.draw.line(screen, DARK, (DIVIDER_X, 0), (DIVIDER_X, screen_height), 2)
    for w in buttons:
        w.draw(is_focused=(focusables[focused_idx] is w))

    if active_panel == 1:
        for w in preset_radios:
            w.draw(is_focused=(focusables[focused_idx] is w))
    elif active_panel == 2:
        for w in mode_radios:
            w.draw(is_focused=(focusables[focused_idx] is w))
    elif active_panel == 3:
        draw_text("Item Difficulty", (PANEL_X, 20))
        for w in item_radios:
            w.draw(is_focused=(focusables[focused_idx] is w))
        draw_text("Enemy Difficulty", (PANEL_X, 160))
        for w in enemy_radios:
            w.draw(is_focused=(focusables[focused_idx] is w))
    elif active_panel == 4:
        for w in flag_checks:
            w.draw(is_focused=(focusables[focused_idx] is w))
    else:
        continue

    pygame.display.flip()
    clock.tick(60)
